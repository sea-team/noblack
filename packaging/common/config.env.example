# Noblack 离线运行包配置
# 将本文件复制为 config.env 后生效；已存在的同名系统环境变量优先于本文件。
# 每行格式为 KEY=value。只修改等号右侧，不要在值后追加行内注释。

# Go HTTP 服务监听地址，默认 :8080 表示监听所有网卡的 8080 端口；
# 如只允许本机访问，可改为 127.0.0.1:8080。
NB_ADDR=:8080

# 双模型服务监听端口。模型服务据此监听，主服务据此连接（固定为本机 127.0.0.1）。
# 仅词库模式下该项无效。
NB_MODEL_PORT=8091

# PyTorch 使用的 CPU 线程数，必须为大于等于 1 的整数；通常不应超过 CPU 核心数。
NB_MODEL_THREADS=2

# Lite 与 MacBERT 的结果合并策略：
# max：任一模型判定为较高风险时采用较严格结果；consensus：两个模型达成一致后才升级风险。
NB_MODEL_COMBINE_POLICY=max

# 模型通过阈值，范围为 0～1；风险概率低于该值时返回 pass。
# 必须小于 NB_MODEL_BLOCK_THRESHOLD。
NB_MODEL_PASS_THRESHOLD=0.15

# 模型拦截阈值，范围为 0～1；风险概率大于等于该值时返回 block；
# 介于通过阈值和拦截阈值之间时返回 review。
NB_MODEL_BLOCK_THRESHOLD=0.5

# AI 模型单次审核允许的最大文本字符数，必须为正整数。
NB_MODEL_MAX_TEXT_CHARS=20000

# 是否监听 data/words.json 的变化并自动热加载词库，可选 true 或 false。
NB_WATCH=true

# 是否忽略英文词条大小写，可选 true 或 false；主要影响英文匹配。
NB_CI=false

# 是否归一化输入以对抗变体绕过，可选 true 或 false，默认 true。
# 开启后会先去除文本中的标点、空格、Emoji、零宽字符和下划线，并做繁简、
# 全角半角、大小写折叠，再交给词库和模型检测。
# 效果：炸.药、炸 药、炸_药、槍支 都能被正常识别。
# 命中位置仍指向原文，不影响前端高亮。正常文本（如 99.5元）不受影响。
NB_NORMALIZE=true

# 语义样本库文件路径，用于补足模型漏报；留空表示禁用。
# 启用后可通过 POST /samples 接口把模型漏报的整句提交上来，立即生效，
# 无需重新训练模型。检测时用字符 n-gram 相似度召回相似句式。
# 建议设置为 data/samples.json。
NB_SAMPLES=

# 语义样本相似度阈值，范围 0～1，默认 0.75。
# 越低召回越激进但误报升高；越高越严格但只能匹配几乎逐字相同的文本。
NB_SAMPLE_THRESHOLD=0.75

# 统计数据持久化文件路径；留空表示仅保存在内存中，服务重启后统计归零。
# 如需持久化，可设置为 data/stats.json。
NB_STATS=

# 词库新增、修改、删除接口的鉴权令牌；留空表示写操作不鉴权。
# 生产环境建议设置为随机且足够长的字符串。
NB_TOKEN=

# 检测接口（/check 和 /stats）的鉴权令牌；留空表示检测接口不鉴权，
# 任何能访问到服务端口的人都可以无限制调用检测。
# 与 NB_TOKEN 分开设置，便于把检测权限发给业务方，而不连带给出词库写权限。
# 上面的 NB_TOKEN 权限更高，同样可以调用检测接口，因此管理页面只需填一个令牌。
# 生产环境建议设置为随机且足够长的字符串。
# 调用方通过请求头传递：X-Auth-Token: <令牌> 或 Authorization: Bearer <令牌>。
# 注意：/health 健康检查始终公开，不受此项影响，以免探针失败。
NB_DETECT_TOKEN=

# 检测模式，决定词库与 AI 模型两条链路如何配合，可选值：
#   word_only    仅词库，完全不调用模型。
#   model_only   仅模型，模型不可用时不回退词库。
#   model_first  模型优先，仅当模型不可用或超时时才回退词库。
#   word_first   词库优先，词库未命中时默认直接返回（除非开启下面的召回开关）。
#   both         词库与模型同时检测，任一命中即拦截（默认值）。
# 留空表示使用默认值 both。
# 注意：model_only 和 model_first 需要模型服务，
# 使用 start-keywords-only.sh / start-keywords-only.cmd 启动时不可选用这两项。
NB_DETECT_MODE=both

# 优先链路“未命中”时，是否补跑另一条链路以提高召回，可选 true 或 false。
# 例如 word_first 模式下词库没查到时，再交给模型判断一次。
# 注意：这里的“未命中”指链路正常返回但判定为无风险，
# 与模型服务不可用、超时等技术故障导致的自动降级无关，后者由检测模式本身处理。
# 开启后会增加一次额外检测的耗时，默认关闭。
NB_RECALL_ON_MISS=false

# 以下配置用于分别覆盖 Lite 和 MacBERT 的阈值。
# 不需要单独调整时请保持注释，两个模型会使用上面的共用阈值。
# NB_LITE_PASS_THRESHOLD=0.15
# NB_LITE_BLOCK_THRESHOLD=0.5
# NB_MACBERT_PASS_THRESHOLD=0.15
# NB_MACBERT_BLOCK_THRESHOLD=0.5
